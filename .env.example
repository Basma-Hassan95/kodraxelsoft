# Frontend (copy to .env.local for local; set same keys in Vercel for production)

# Local backend
NEXT_PUBLIC_CMS_API_URL=http://localhost:5000/api

# Production (Vercel) — MUST point to your hosted Express CMS API, NOT localhost
# Example: https://kodraxelsoft-api.onrender.com/api
# CMS_API_INTERNAL_URL=https://YOUR-BACKEND-HOST/api
# NEXT_PUBLIC_CMS_API_URL=https://YOUR-BACKEND-HOST/api
