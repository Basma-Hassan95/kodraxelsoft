# =============================================================================
# Vercel Environment Variables (Project → Settings → Environment Variables)
# =============================================================================
# Set these for Production + Preview, then Redeploy.

# Required for admin login / CMS on the live site.
# Point to your HOSTED Express API (Render / Railway / etc.) — NOT localhost.
CMS_API_INTERNAL_URL=https://YOUR-BACKEND-HOST/api
NEXT_PUBLIC_CMS_API_URL=https://YOUR-BACKEND-HOST/api

# Local development only (copy to .env.local)
# NEXT_PUBLIC_CMS_API_URL=http://localhost:5000/api
