# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# JWT — use a long random secret (32+ chars). Required in production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h

# Optional: required in production for first-admin signup via API
# BOOTSTRAP_SECRET=your-private-bootstrap-key
# DISABLE_ADMIN_BOOTSTRAP=true

# Brute-force protection
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Supabase — copy real values into backend/.env only (never commit secrets)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Storage bucket (must match SQL setup)
SUPABASE_STORAGE_BUCKET=media

# Single admin bootstrap (used by npm run seed:admin)
ADMIN_EMAIL=admin@kodraxelsoft.com
ADMIN_PASSWORD=ChangeMeStrongPassword123!
ADMIN_NAME=Kodraxelsoft Admin
