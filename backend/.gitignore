# ---------------------------------------------------------------------------
# Commit these SQL files (schema / seed — not secrets):
#   supabase/migrations/*.sql
#   supabase/seed.sql
# ---------------------------------------------------------------------------
!supabase/migrations/
!supabase/migrations/*.sql
!supabase/seed.sql
.vercel
.env*
